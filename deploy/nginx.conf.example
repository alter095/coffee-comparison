# Include this server block from your Nginx http context after editing the
# listen address, server name, certificate paths, and application upstream.
# COFFEE_ORIGIN must match the browser URL, including a non-default port.
# The default listen address is local-only. For private LAN access, explicitly
# select the server's LAN address and trust its certificate on each client.
server {
    listen 127.0.0.1:8443 ssl;
    server_name coffee.example.com;

    ssl_certificate /etc/nginx/tls/coffee/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/coffee/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 1m;
    access_log off;

    location / {
        proxy_pass http://127.0.0.1:3180;
        proxy_http_version 1.1;
        # $host drops a non-default browser port; preserve the original Host.
        proxy_set_header Host $http_host;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 35s;
    }
}
